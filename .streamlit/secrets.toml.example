# Local-run template ONLY. Copy to .streamlit/secrets.toml and fill in, OR
# (preferred) rely on a CLI connection via:
#   SNOWFLAKE_DEFAULT_CONNECTION_NAME=oregon-sedemo uv run streamlit run app/streamlit_app.py
#
# This app uses a Snowpark session (lib/session.py), which reads CLI connections
# from ~/.snowflake/connections.toml. You typically do NOT need this file at all
# when a CLI connection exists. It is provided for password-based local runs.
#
# NEVER commit the real secrets.toml (see .gitignore).

[connections.snowflake]
account = "sfseeurope-wkot_demo1"
user = "<YOUR_USER>"
authenticator = "externalbrowser"
warehouse = "COMPUTE_WH"
database = "SNOWFLAKE_LEARNING_DB"
schema = "GIT_SIS"
